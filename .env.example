# Tệp này là mẫu cho các biến môi trường của bạn. 
# Hãy sao chép nó thành một tệp mới có tên là .env và điền các giá trị phù hợp với môi trường của bạn.

# Chỉ định thư mục nơi Node.js lưu trữ bộ nhớ đệm mã đã biên dịch V8 cho các mô-đun, giúp tăng tốc độ khởi động.
NODE_COMPILE_CACHE=node_modules/.node-compile-cache

# ==========================
# Cấu hình Nx 
# ==========================

# Đặt thành true để bật Nx Daemon; tính năng này giúp tăng tốc các lần chạy lệnh Nx tiếp theo bằng cách duy trì một tiến trình chạy ngầm. 
# Đặt thành false để tắt tính năng này. Chúng tôi khuyến nghị nên tắt Nx Daemon trong môi trường CI, môi trường cloud (Agent cloud),
# hoặc khi sử dụng nhiều agent chạy song song để  tránh việc để  lại nhiều nx daemon process mồ  côi
NX_DAEMON=false  
# Hãy điều chỉnh giá trị này dựa trên số nhân CPU và dung lượng RAM của máy bạn. Cấu hình này cho phép Nx thực thi các tác vụ song song, 
# từ đó rút ngắn thời gian xây dựng (build). Khi sử dụng nhiều agent chạy song song, giá trị này nên được đặt là 1 để tránh lỗi 
# OOM (hết bộ nhớ - Out of Memory) khi các agent cùng thực thi lệnh Nx.
NX_PARALLEL=3
# Cấu hình bộ nhớ đệm từ xa (Remote Cache) của Nx giúp tăng tốc quá trình build bằng cách lưu trữ các kết quả build (build artifacts) trên một máy chủ từ xa, 
# cho phép tái sử dụng chúng trong các quy trình CI hoặc trên các agent khác.
NX_SELF_HOSTED_REMOTE_CACHE_SERVER=
NX_SELF_HOSTED_REMOTE_CACHE_ACCESS_TOKEN=

# ==========================
# Cấu hình LLM configuration 
# ==========================
LLM_BASE_URL=
LLM_API_KEY=
LLM_REVIEW_MODEL=