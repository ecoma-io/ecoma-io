{
  // `index.ts` import hai helper **nguồn** của `tools/dx` (không phải package đã
  // build): `../../tools/dx/src/<name>` (không đuôi) là cách duy nhất hai deploy
  // unit dùng chung một nguồn sự thật cho namespace và contract outputs, thay
  // vì copy hàm vào hai nơi rồi để chúng lệch nhau. Specifier **KHÔNG chữ
  // `.js`**: Pulumi runtime `nodejs` chạy thẳng `index.ts` qua ts-node vendor
  // 7.0.1 (không có ESM loader, `ts-node@7` không có mapping `.js`→`.ts`) nên
  // specifier `.js` → `Cannot find module`, còn không đuôi resolve đúng `*.ts`.
  // Chi tiết đo được ghi ở `deploys/platform-deploy/tsconfig.json` — hai file
  // PHẢI nói cùng một quy tắc. `module: nodenext` vẫn giữ để typecheck theo
  // chuẩn ESM.
  //
  // Hệ quả bắt buộc: `rootDir` phải nới lên **workspace root** (`../..`) —
  // mặc định `rootDir` là thư mục project nên `tools/dx/src/*.ts` nằm ngoài nó
  // và `tsc` fail với TS6059. `files` cũng phải liệt kê tường minh hai file đó
  // vì project `composite` bắt buộc mọi file trong graph đều được khai.
  //
  // Đổi lại, output của `tsc --build` nằm ở `bin/deploys/home-deploy/` và
  // `bin/tools/dx/` thay vì `bin/index.js`. Pulumi không dùng output này —
  // runtime `nodejs` chạy thẳng `index.ts`.
  "compilerOptions": {
    "strict": true,
    "outDir": "bin",
    "rootDir": "../..",
    "target": "es2020",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "sourceMap": true,
    "experimentalDecorators": true,
    "pretty": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "forceConsistentCasingInFileNames": true,
    // Project này không `extends` `tsconfig.base.json`, nên không kế thừa
    // `skipLibCheck` của nó — bật tường minh cho khớp `platform-deploy`:
    // typecheck không phải rà `.d.ts` của `@pulumi/*` và `@node-rs/xxhash`,
    // lỗi type bên thứ ba không làm đỏ typecheck của repo.
    "skipLibCheck": true,
    "composite": true,
    "declaration": true,
    // Pulumi program chạy trên Node và import helper của `tools/dx` đọc
    // `node:fs`/`node:path`, nên khai ambient types của Node tường minh thay vì
    // để mặc định "mọi @types trong node_modules".
    "types": ["node"]
  },
  "files": [
    "index.ts",
    "../../tools/dx/src/deploy-namespace.ts",
    "../../tools/dx/src/platform-outputs-contract.ts"
  ]
}
