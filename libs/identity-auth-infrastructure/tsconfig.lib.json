{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "outDir": "dist",
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": [],
    "rootDir": "src",
    "lib": ["es2022", "dom"],
    "tsBuildInfoFile": "dist/tsconfig.lib.tsbuildinfo"
  },
  "include": ["src/**/*.ts"],
  "exclude": ["out-tsc", "dist", "src/**/*.test.ts", "src/**/*.spec.ts"],
  "references": [
    {
      "path": "../identity-auth-domain"
    },
    {
      "path": "../identity-auth-application"
    },
    {
      "path": "../identity-contracts/tsconfig.lib.json"
    }
  ],
  "nx": {
    "sync": { "ignoredReferences": ["../identity-contracts/tsconfig.lib.json"] }
  }
}
