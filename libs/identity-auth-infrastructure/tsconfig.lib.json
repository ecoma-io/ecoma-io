{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "outDir": "dist",
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": [],
    "rootDir": "src",
    "lib": ["es2022", "dom"],
    "tsBuildInfoFile": "dist/tsconfig.lib.tsbuildinfo"
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "out-tsc",
    "dist",
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    // Harness + probe Docker chỉ tồn tại lúc test (test-only Node tooling):
    // không thuộc bundle lib, và lib build không cần `node`/vitest types.
    "src/auth-test-harness.ts",
    "src/docker-probe.ts",
    "src/docker-probe.global-setup.ts"
  ],
  "references": [
    {
      "path": "../identity-auth-domain"
    },
    {
      "path": "../identity-auth-application"
    },
    {
      "path": "../internal-auth-contracts/tsconfig.lib.json"
    }
  ],
  "nx": {
    "sync": { "ignoredReferences": ["../internal-auth-contracts/tsconfig.lib.json"] }
  }
}
