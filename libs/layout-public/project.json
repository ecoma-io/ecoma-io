{
  "name": "layout-public",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/layout-public/src",
  "projectType": "library",
  "tags": ["type:lib", "scope:public", "runtime:universal"],
  "// targets": "to see all targets run: nx show project layout-public --web",
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vue-tsc --noEmit --composite false -p tsconfig.spec.json",
        "cwd": "{projectRoot}"
      },
      "inputs": ["default"]
    }
  }
}
