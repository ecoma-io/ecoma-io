{
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "name": "llm-seller-pricing-domain",
  "root": "contexts/llm/seller-pricing/domain",
  "sourceRoot": "contexts/llm/seller-pricing/domain/src",
  "tags": ["scope:llm-seller", "kind:domain"],
  "metadata": {
    "description": "Pricing domain of the LLM Seller bounded context: per-offer versioned pricing schedules, per-request/per-token pricing, peak/off-peak by IANA timezone, immutable snapshots and fixed-point arithmetic."
  },
  "targets": {
    "lint": {
      "executor": "@nx/oxlint:lint",
      "cache": true,
      "inputs": [
        {
          "fileset": "{projectRoot}/**/*.{js,mjs,cjs,jsx,ts,mts,cts,tsx,vue,svelte,astro}"
        },
        {
          "fileset": "{projectRoot}/**/*.{js,mjs,cjs,jsx,ts,mts,cts,tsx,vue,svelte,astro}",
          "dependencies": true
        },
        {
          "fileset": "{projectRoot}/**/{.oxlintrc.json,.oxlintrc.jsonc,oxlint.config.ts,oxlint.config.mts.gitignore,tsconfig*.json}"
        },
        "{workspaceRoot}/.oxlintrc.json",
        "{workspaceRoot}/contexts/.gitignore",
        "{workspaceRoot}/.gitignore",
        {
          "externalDependencies": ["oxlint"]
        }
      ],
      "configurations": {},
      "options": {}
    },
    "typecheck": {
      "cache": true,
      "inputs": [
        "{workspaceRoot}/tsconfig.base.json",
        "{projectRoot}/tsconfig.json",
        "{projectRoot}/tsconfig.lib.json",
        "{projectRoot}/tsconfig.spec.json",
        "{projectRoot}/src/**/*.ts",
        "{projectRoot}/index.ts",
        "{projectRoot}/vite.config.ts",
        "{projectRoot}/vite.config.mts",
        "{projectRoot}/vitest.config.ts",
        "{projectRoot}/vitest.config.mts",
        "{projectRoot}/src/**/*.test.ts",
        "{projectRoot}/src/**/*.spec.ts",
        "{projectRoot}/src/**/*.test.tsx",
        "{projectRoot}/src/**/*.spec.tsx",
        "{projectRoot}/src/**/*.test.js",
        "{projectRoot}/src/**/*.spec.js",
        "{projectRoot}/src/**/*.test.jsx",
        "{projectRoot}/src/**/*.spec.jsx",
        "{projectRoot}/src/**/*.d.ts",
        {
          "dependentTasksOutputFiles": "**/*.{d.ts,d.cts,d.mts,tsbuildinfo}",
          "transitive": true
        },
        {
          "fileset": "{projectRoot}/**/*.{d.ts,d.cts,d.mts}",
          "dependencies": true
        },
        "^{projectRoot}/tsconfig.lib.json"
      ],
      "outputs": [
        "{projectRoot}/tsconfig.tsbuildinfo",
        "{projectRoot}/dist/**/*.{d.ts,d.cts,d.mts}",
        "{projectRoot}/dist/**/*.{d.ts,d.cts,d.mts}.map",
        "{projectRoot}/dist/tsconfig.lib.tsbuildinfo",
        "{projectRoot}/out-tsc/vitest/**/*.{d.ts,d.cts,d.mts}",
        "{projectRoot}/out-tsc/vitest/tsconfig.spec.tsbuildinfo"
      ],
      "syncGenerators": ["@nx/js:typescript-sync"],
      "executor": "nx:run-commands",
      "options": {
        "cwd": "contexts/llm/seller-pricing/domain",
        "command": "tsc --build tsconfig.json --emitDeclarationOnly"
      },
      "configurations": {},
      "parallelism": true
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "default",
        "^production",
        {
          "fileset": "{projectRoot}/tsconfig.spec.json",
          "dependencies": true
        },
        {
          "fileset": "{projectRoot}/tsconfig.storybook.json",
          "dependencies": true
        },
        {
          "json": "{workspaceRoot}/tsconfig.json",
          "fields": ["compilerOptions"]
        },
        {
          "externalDependencies": ["vitest"]
        },
        {
          "env": "CI"
        },
        {
          "dependentTasksOutputFiles": "**/*.js",
          "transitive": true
        }
      ],
      "outputs": ["{projectRoot}/test-output/vitest/coverage"],
      "options": {
        "cwd": "contexts/llm/seller-pricing/domain",
        "command": "vitest run"
      },
      "configurations": {},
      "parallelism": true
    }
  }
}
