{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "analytics": false,
  "neverConnectToCloud": true,
  "tui": {
    "enabled": false
  },
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "production": [
      "default",
      "!{projectRoot}/.oxlintrc.json",
      "!{projectRoot}/**/?(*.)+(spec|test).[jt]s?(x)?(.snap)",
      "!{projectRoot}/tsconfig.spec.json",
      "!{projectRoot}/.output",
      "!{projectRoot}/.nuxt",
      "!{projectRoot}/dist"
    ],
    "sharedGlobals": []
  },
  "plugins": [
    {
      "plugin": "@nx/js/typescript",
      "options": {
        "typecheck": {
          "targetName": "typecheck"
        },
        "build": {
          "targetName": "build",
          "configName": "tsconfig.lib.json",
          "buildDepsName": "build-deps",
          "watchDepsName": "watch-deps"
        }
      }
    },
    {
      "plugin": "@nx/oxlint",
      "options": {
        "targetName": "lint"
      }
    },
    {
      "plugin": "@nx/vitest",
      "options": {
        "testTargetName": "test",
        "testMode": "watch"
      }
    },
    {
      "plugin": "@nx/nuxt/plugin",
      "options": {
        "buildTargetName": "build",
        "serveTargetName": "serve",
        "buildDepsTargetName": "build-deps",
        "watchDepsTargetName": "watch-deps",
        "serveStaticTargetName": "serve-static",
        "buildStaticTargetName": "build-static"
      }
    }
  ],
  "release": {
    "projects": ["@ecoma-io/home"],
    "projectsRelationship": "independent",
    "version": {
      "conventionalCommits": true,
      "fallbackCurrentVersionResolver": "disk"
    },
    "versionPlans": true,
    "git": {
      "commit": false,
      "commitMessage": "chore(release): release {projectName} {version}",
      "tag": false,
      "push": false
    },
    "changelog": {
      "projectChangelogs": {
        "file": "{projectRoot}/CHANGELOG.md"
      }
    },
    "releaseTag": {
      "pattern": "{projectName}@{version}"
    }
  },
  "targetDefaults": {
    "test": {
      "dependsOn": [],
      "metadata": {
        "//": [
          "Mặc định KHÔNG build upstream trước unit test. Mọi package workspace",
          "export thẳng `./src/index.ts` (điều kiện `@ecoma-io/source` + `default`",
          "trong `exports`), vitest chạy TS nguồn trực tiếp — không spec nào import",
          "`dist/`, nên `^build` từng là chi phí chết: mỗi `nx test` kéo cả chuỗi",
          "build của mọi lib phụ thuộc (L0 baseline 2026-10: ~795s/39 project,",
          "phần lớn là build không ai đọc). App nào test thật sự cần artifact build",
          "phải khai `dependsOn` riêng ở project của nó (vd `apps/home` đọc",
          "`.output/` sau `build`, `apps/account` test-integration đọc bundle",
          "Nitro) — mặc định chung này chỉ phục vụ lane unit, nơi artifact không",
          "tồn tại trong imports."
        ]
      }
    },
    "@nx/esbuild:esbuild": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": [
        "production",
        "^production",
        {
          "json": "{workspaceRoot}/tsconfig.json",
          "fields": ["extends", "files", "include"]
        },
        "{workspaceRoot}/pnpm-workspace.yaml",
        {
          "json": "{workspaceRoot}/package.json",
          "fields": [
            "packageManager",
            "pnpm.onlyBuiltDependencies",
            "pnpm.neverBuiltDependencies",
            "pnpm.allowBuilds",
            "pnpm.supportedArchitectures",
            "pnpm.patchedDependencies"
          ]
        },
        {
          "runtime": "node -e \"try{console.log('pnpm major '+require('child_process').execSync('pnpm --version',{stdio:['ignore','pipe','ignore']}).toString().trim().split('.')[0])}catch{console.log('pnpm major unavailable')}\""
        }
      ]
    },
    "provision": [
      {
        "filter": {
          "projects": ["tag:type:deployment"]
        },
        "dependsOn": ["^provision"],
        "metadata": {
          "//": "Provisioning order is a CONTRACT, and it is scoped to the deployment lane ONLY. A project graph edge is metadata; `dependsOn` is what actually orders the TASK graph. Without this, `nx run <app-deploy>:provision` would happily run with the platform never provisioned — the edge exists but nothing schedules it. Scoping by `tag:type:deployment` (instead of a global `^provision`) is deliberate: a global rule would attach provisioning to every project that has a dependency on a deploy project, dragging infrastructure orchestration into the application release path."
        }
      }
    ],
    "local-up": [
      {
        "filter": {
          "projects": ["tag:type:deployment"]
        },
        "cache": false,
        "metadata": {
          "//": "Local deployment lane targets. Thứ tự là CONTRACT nhưng NẰM TRONG từng deploy project (target `local-up` khai `dependsOn` riêng của nó trong `deploys/*/package.json`) — `nx.json` chỉ đặt chính sách chung: `cache: false` là CONTRACT chứ không phải tối ưu, target mutate Docker resource và Pulumi state thật của máy developer, cache hit là bỏ một side effect. Một unit test chặn target local-* quay lại cacheable hoặc sinh configuration (lane) mới — lane local phải là lane DUY NHẤT của các target này."
        }
      }
    ],
    "local-smoke": [
      {
        "filter": {
          "projects": ["platform-deploy"]
        },
        "cache": false,
        "metadata": {
          "//": "Xem entry `local-up`: lane local duy nhất, không bao giờ cacheable, thứ tự từ `dependsOn` của project."
        }
      }
    ]
  }
}
