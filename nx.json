{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "analytics": false,
  "neverConnectToCloud": true,
  "tui": {
    "enabled": false
  },
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "production": [
      "default",
      "!{projectRoot}/.oxlintrc.json",
      "!{projectRoot}/**/?(*.)+(spec|test).[jt]s?(x)?(.snap)",
      "!{projectRoot}/tsconfig.spec.json",
      "!{projectRoot}/.output",
      "!{projectRoot}/.nuxt",
      "!{projectRoot}/dist"
    ],
    "sharedGlobals": []
  },
  "plugins": [
    {
      "plugin": "@nx/js/typescript",
      "options": {
        "typecheck": {
          "targetName": "typecheck"
        },
        "build": {
          "targetName": "build",
          "configName": "tsconfig.lib.json",
          "buildDepsName": "build-deps",
          "watchDepsName": "watch-deps"
        }
      },
      "exclude": [
        "libs/i18n-public/*",
        "libs/layout-public-sidenav/*",
        "libs/layout-public/*",
        "libs/logo/*"
      ]
    },
    {
      "plugin": "@nx/oxlint",
      "options": {
        "targetName": "lint"
      }
    },
    {
      "plugin": "@nx/vitest",
      "options": {
        "testTargetName": "test",
        "ciTargetName": "test-ci",
        "testMode": "watch"
      }
    },
    {
      "plugin": "@nx/nuxt/plugin",
      "options": {
        "buildTargetName": "build",
        "serveTargetName": "serve",
        "buildDepsTargetName": "build-deps",
        "watchDepsTargetName": "watch-deps",
        "serveStaticTargetName": "serve-static",
        "buildStaticTargetName": "build-static"
      }
    },
    {
      "plugin": "@nx/playwright/plugin",
      "options": {
        "targetName": "e2e"
      }
    },
    {
      "plugin": "@nx/js/typescript",
      "include": [
        "libs/i18n-public/*",
        "libs/layout-public-sidenav/*",
        "libs/layout-public/*",
        "libs/logo/*"
      ],
      "options": {
        "typecheck": {
          "targetName": "typecheck"
        }
      }
    }
  ],
  "release": {
    // Nx Release per-project cho deploy unit `home` — PR2 (Issue #78). Quan hệ
    // `independent`: mỗi deploy unit tự version, không bump dây chuyền theo
    // workspace. Conventional commits quyết định bump level; `fallbackCurrent
    // VersionResolver: disk` đọc version hiện tại từ package.json của project.
    "projects": ["@ecoma-io/home"],
    "projectsRelationship": "independent",
    "version": {
      "conventionalCommits": true,
      "fallbackCurrentVersionResolver": "disk"
    },
    "git": {
      // Release commit (squash-merge trên main) cập nhật package.json +
      // CHANGELOG.md của project. KHÔNG tag ở đây: tag chỉ được tạo sau khi
      // staging smoke pass trên đúng SHA đã verify — chain order là
      // CI → staging deploy → smoke → commit status `home/staging-verified`
      // → job tag tạo `@ecoma-io/home@{version}` trên SHA đã verify.
      // `push: false` — runner tự push tag bằng GH_TOKEN của job `tag`
      // (job duy nhất có `contents: write`).
      "commit": true,
      "commitMessage": "chore(home): release {projectName} {version}",
      "tag": false,
      "push": false
    },
    "changelog": {
      "projectChangelogs": {
        "file": "{projectRoot}/CHANGELOG.md"
      }
    },
    // Tag pattern theo §3 PR2: `{projectName}@{version}` — tên project là
    // `@ecoma-io/home` (không phải tên thư mục `home`).
    "releaseTag": {
      "pattern": "{projectName}@{version}"
    }
  },
  "targetDefaults": {
    "test": {
      "dependsOn": ["^build"]
    },
    "@nx/esbuild:esbuild": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": [
        "production",
        "^production",
        {
          "json": "{workspaceRoot}/tsconfig.json",
          "fields": ["extends", "files", "include"]
        },
        "{workspaceRoot}/pnpm-workspace.yaml",
        {
          "json": "{workspaceRoot}/package.json",
          "fields": [
            "packageManager",
            "pnpm.onlyBuiltDependencies",
            "pnpm.neverBuiltDependencies",
            "pnpm.allowBuilds",
            "pnpm.supportedArchitectures",
            "pnpm.patchedDependencies"
          ]
        },
        {
          "runtime": "node -e \"try{console.log('pnpm major '+require('child_process').execSync('pnpm --version',{stdio:['ignore','pipe','ignore']}).toString().trim().split('.')[0])}catch{console.log('pnpm major unavailable')}\""
        }
      ]
    }
  }
}
