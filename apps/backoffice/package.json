{
  "name": "@ecoma-io/backoffice",
  "version": "0.0.1",
  "private": true,
  "devDependencies": {
    "@vite-pwa/assets-generator": "1.0.4",
    "@vite-pwa/nuxt": "1.1.1"
  },
  "nx": {
    "tags": [
      "type:web",
      "scope:backoffice",
      "runtime:edge"
    ],
    "targets": {
      "deploy": {
        "executor": "nx:run-commands",
        "defaultConfiguration": "production",
        "dependsOn": [
          "build"
        ],
        "options": {
          "cwd": "apps/backoffice",
          "command": "npx wrangler deploy --config wrangler.jsonc"
        },
        "configurations": {
          "development": {},
          "production": {}
        }
      },
      "nuxt-prepare": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "apps/backoffice",
          "command": "npx nuxt prepare"
        }
      },
      "test": {
        "dependsOn": [
          "nuxt-prepare"
        ]
      }
    }
  }
}
