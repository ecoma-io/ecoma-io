{
  "name": "@ecoma-io/backoffice",
  "version": "0.0.1",
  "private": true,
  "dependencies": {
    "@ecoma-io/backoffice-application": "workspace:*",
    "@ecoma-io/backoffice-domain": "workspace:*",
    "@ecoma-io/backoffice-infrastructure": "workspace:*",
    "@ecoma-io/ui-app-shell": "workspace:*",
    "@ecoma-io/ui-ecoma-logo": "workspace:*",
    "jose": "6.2.13"
  },
  "devDependencies": {
    "@nuxtjs/i18n": "10.6.0",
    "@testcontainers/postgresql": "12.2.1",
    "@types/pg": "^8.23.1",
    "@vite-pwa/assets-generator": "1.0.4",
    "@vite-pwa/nuxt": "1.1.1",
    "pg": "^8.23.1",
    "testcontainers": "12.2.1"
  },
  "nx": {
    "tags": [
      "type:composition",
      "scope:backoffice",
      "runtime:edge"
    ],
    "targets": {
      "nuxt-prepare": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "apps/backoffice",
          "command": "npx nuxt prepare"
        }
      },
      "typecheck": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "^typecheck",
          "nuxt-prepare"
        ],
        "cache": true,
        "inputs": [
          "default",
          "{workspaceRoot}/tsconfig.base.json",
          {
            "externalDependencies": [
              "vue-tsc"
            ]
          }
        ],
        "options": {
          "cwd": "apps/backoffice",
          "command": "npx nuxt typecheck"
        },
        "//": [
          "Ghi đè target `typecheck` mặc định của plugin @nx/js (echo no-op),",
          "mirror đúng cách apps/home đã làm: Nuxt sinh `.nuxt/tsconfig.*.json`",
          "với `noEmit: true`, còn target mặc định chạy `tsc --build",
          "--emitDeclarationOnly` — hai option xung đột (TS5069), và trước",
          "nuxt-prepare thì các file đó chưa tồn tại (TS5083). `nuxt typecheck`",
          "(vue-tsc qua @nuxt/cli) là đường đúng: hiểu project references Nuxt 4,",
          "dùng đúng các `.nuxt/tsconfig.*.json`, và bắt được lỗi type thật.",
          "Bị bỏ sót cho đến khi lockfile thay đổi làm `nx affected` gồm cả",
          "project này — target chỉ pass ở dạng bị plugin tắt (no-op), runner",
          "sạch sẽ hard-fail TS5083 khi tập affected mở rộng."
        ]
      },
      "test": {
        "dependsOn": [
          "nuxt-prepare"
        ]
      },
      "db:migrate": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "cwd": "apps/backoffice",
          "command": "npx tsx --tsconfig tsconfig.db.json db/apply.mts"
        }
      },
      "test-integration": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "build",
          "nuxt-prepare"
        ],
        "options": {
          "cwd": "apps/backoffice",
          "command": "npx vitest run -c vitest.integration.config.mts tests/integrations tests/databases"
        }
      },
      "typecheck-db": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "apps/backoffice",
          "command": "npx tsc --noEmit -p tsconfig.db.json"
        }
      }
    }
  }
}
