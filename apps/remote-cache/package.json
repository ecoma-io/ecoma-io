{
  "name": "@ecoma-io/remote-cache",
  "private": true,
  "type": "module",
  "dependencies": {
    "@ecoma-io/remote-cache-contracts": "workspace:*",
    "@ecoma-io/remote-cache-domain": "workspace:*",
    "@ecoma-io/remote-cache-infrastructure": "workspace:*",
    "hono": "^4.13.13",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "12.2.1",
    "@types/pg": "^8.15.6",
    "testcontainers": "12.2.1"
  },
  "//": [
    "`pg` giu o dependencies cho `db/apply.mts` + `db/migrate.mts` — migration",
    "runner chay o CI runner (Node), khong thuoc bundle Worker. Nguon `pg`",
    "runtime cua app la `@ecoma-io/remote-cache-infrastructure` (postgres.js",
    "qua Hyperdrive).",
    "`hono` la runtime HTTP cua Worker; control-plane routes skeleton P4.1."
  ],
  "nx": {
    "tags": [
      "type:composition",
      "scope:remote-cache",
      "runtime:edge"
    ],
    "targets": {
      "build": {
        "executor": "@nx/esbuild:esbuild",
        "outputs": [
          "{options.outputPath}"
        ],
        "defaultConfiguration": "production",
        "options": {
          "platform": "neutral",
          "outputPath": "apps/remote-cache/dist",
          "format": [
            "esm"
          ],
          "bundle": true,
          "main": "apps/remote-cache/src/main.ts",
          "tsConfig": "apps/remote-cache/tsconfig.app.json",
          "esbuildOptions": {
            "sourcemap": true,
            "outExtension": {
              ".js": ".js"
            },
            "conditions": [
              "workerd",
              "worker",
              "browser"
            ],
            "external": [
              "node:buffer",
              "node:events",
              "node:stream"
            ]
          },
          "skipTypeCheck": true,
          "declaration": false
        },
        "configurations": {
          "development": {},
          "production": {
            "esbuildOptions": {
              "sourcemap": false,
              "outExtension": {
                ".js": ".js"
              },
              "conditions": [
                "workerd",
                "worker",
                "browser"
              ],
              "external": [
                "node:buffer",
                "node:events",
                "node:stream"
              ]
            }
          }
        }
      },
      "db:migrate": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "cwd": "apps/remote-cache",
          "command": "npx tsx --tsconfig tsconfig.db.json db/apply.mts"
        }
      },
      "typecheck-db": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "apps/remote-cache",
          "command": "npx tsc --noEmit -p tsconfig.db.json"
        }
      },
      "test-integration": {
        "executor": "nx:run-commands",
        "dependsOn": [],
        "options": {
          "cwd": "apps/remote-cache",
          "command": "npx vitest run -c vitest.integration.config.mts tests/integrations tests/databases"
        },
        "//": [
          "KHONG `build`: suite integration import thang TS nguon — `../../db/apply.mts`,",
          "cac lib qua export workspace. Khong spec nao doc `dist/` hay type do wrangler",
          "sinh ra; esbuild bundle chi tieu thu o lan deploy. Go `build` khoi dependsOn",
          "bo chi phi bundle ma khong doi ca suite chay."
        ]
      }
    }
  }
}
