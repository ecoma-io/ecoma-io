{
  "name": "@ecoma-io/identity",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "tags": [
      "type:web",
      "scope:identity",
      "runtime:edge"
    ],
    "targets": {
      "deploy": {
        "executor": "nx:run-commands",
        "defaultConfiguration": "production",
        "dependsOn": [
          "build"
        ],
        "options": {
          "cwd": "apps/identity",
          "command": "npx wrangler deploy --config wrangler.jsonc"
        },
        "configurations": {
          "development": {},
          "production": {}
        }
      },
      "nuxt-prepare": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "apps/identity",
          "command": "npx nuxt prepare"
        }
      },
      "test": {
        "dependsOn": [
          "nuxt-prepare"
        ]
      }
    }
  }
}
