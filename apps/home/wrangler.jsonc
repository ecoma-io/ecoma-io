{
  // Nuxt/Nitro output cho Cloudflare Workers. Preset `cloudflare_module`
  // bundle server vào một Worker module; `main` trỏ vào entry mà Nitro emit.
  //
  // `assets.directory` là output của `nuxt build --prerender`, phục vụ static
  // asset của app.
  //
  // Worker identity lâu dài — PR không tạo Worker mới, Preview chạy dưới
  // identity này. Reference: docs/overview/02-delivery.md §5.
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "ecoma-home",
  "main": ".output/server/index.mjs",
  "compatibility_date": "2026-10-05",
  // Nitro dựa vào một số Node.js API qua shim nội bộ (stream, buffer).
  // Khác với `cache`: các app này là Nuxt app, không phải Worker thuần,
  // nên `nodejs_compat` ở đây là do Nitro yêu cầu chứ không phải nới lỏng
  // boundary của `runtime:edge`.
  //
  // Cloudflare từ `compatibility_date` 2026-08-04 đã bật sẵn `nodejs_compat`
  // và `nodejs_compat_v2` nên flag ở trên là thừa về mặt runtime. Nhưng KHÔNG
  // bỏ: Nitro đọc chính config này để tự bật `cloudflare.nodeCompat`
  // (nitropack/dist/presets/cloudflare/utils.mjs — nhánh
  // `userCompatibilityFlags.has("nodejs_compat")`), và nodeCompat là thứ quyết
  // định việc build có polyfill Node cho runtime bundle hay không. Bỏ flag ở đây
  // ⇒ Nitro build thiếu shim ⇒ runtime lỗi, mà `wrangler deploy --dry-run`
  // vẫn báo pass.
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".output/public",
    "binding": "ASSETS",
    // `html_handling: "drop-trailing-slash"` — kế thừa URL policy của hai app
    // cũ (`apps/docs`, `apps/blogs`): public URL canonical của repo **không**
    // có trailing slash (`parsePublicPath` của `app/layout` từ chối trailing
    // slash, SEO phát canonical không slash). Mặc định `auto` lại 307
    // `/en/docs` → `/en/docs/`, tức chính canonical URL bị redirect vĩnh viễn.
    "html_handling": "drop-trailing-slash",
    // Không đặt `run_worker_first`: assets-first giữ content pages được phục
    // vụ từ static asset (không invoke Worker), còn mọi request khác — SSR,
    // payload, path lạ — đi vào Worker. Không đặt cả `not_found_handling`:
    // fallback đó phục vụ `404.html` cho request không khớp asset mà không
    // invoke Worker, tức sẽ nuốt SSR của `/en`, `/en/legal/*` và error page
    // SSR cho path content lạ (404 trong app hợp nhất là sản phẩm của Worker:
    // middleware gate + `error.vue`). `404.html` vẫn được prerender để giữ
    // artifact-level tương thích nhưng cố ý không wire vào serving.
  },
  "observability": {
    "enabled": true,
  },
  "dev": {
    "port": 4200,
  },
}
