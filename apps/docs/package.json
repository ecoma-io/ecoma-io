{
  "name": "@ecoma-io/docs",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "tags": [
      "type:web",
      "scope:public",
      "runtime:edge"
    ],
    "targets": {
      "deploy": {
        "executor": "nx:run-commands",
        "defaultConfiguration": "production",
        "dependsOn": [
          "build-static"
        ],
        "options": {
          "cwd": "apps/docs",
          "command": "npx wrangler deploy --config wrangler.jsonc"
        },
        "configurations": {
          "development": {},
          "production": {}
        }
      },
      "nuxt-prepare": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "apps/docs",
          "command": "npx nuxt prepare"
        }
      },
      "typecheck": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "^typecheck",
          "nuxt-prepare"
        ],
        "cache": true,
        "inputs": [
          "default",
          "{workspaceRoot}/tsconfig.base.json",
          {
            "externalDependencies": [
              "vue-tsc"
            ]
          }
        ],
        "options": {
          "cwd": "apps/docs",
          "command": "npx nuxt typecheck"
        },
        "//": [
          "Ghi đè target `typecheck` mặc định của plugin @nx/js (echo no-op):",
          "Nuxt sinh `.nuxt/tsconfig.*.json` với `noEmit: true`, còn target mặc định",
          "chạy `tsc --build --emitDeclarationOnly` — hai option đó xung đột nên plugin",
          "thay bằng echo. `nuxt typecheck` (vue-tsc qua @nuxt/cli) là đường đúng:",
          "nó hiểu project references Nuxt 4, dùng đúng các `.nuxt/tsconfig.*.json`,",
          "và bắt được lỗi type thật (đã xác minh với một file chứa TS2322 cố ý)."
        ]
      },
      "test": {
        "dependsOn": [
          "nuxt-prepare"
        ]
      }
    }
  }
}
