{
  "name": "@ecoma-io/web-push-notification-job",
  "version": "0.0.1",
  "private": true,
  "dependencies": {
    "@ecoma-io/push-notification-contracts": "workspace:*",
    "@ecoma-io/push-notification-domain": "workspace:*",
    "@ecoma-io/push-notification-infrastructure": "workspace:*",
    "@ecoma-io/web-push-notification-job-application": "workspace:*",
    "@ecoma-io/web-push-notification-job-infrastructure": "workspace:*"
  },
  "nx": {
    "tags": [
      "type:composition",
      "scope:notifications",
      "runtime:edge"
    ],
    "targets": {
      "deploy": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "build"
        ],
        "options": {
          "forwardAllArgs": false,
          "command": "npx tsx tools/delivery/src/deploy-gate.mts --project @ecoma-io/web-push-notification-job"
        },
        "configurations": {
          "staging": {
            "command": "npx tsx tools/delivery/src/deploy-gate.mts --project @ecoma-io/web-push-notification-job --lane staging"
          },
          "production": {
            "command": "npx tsx tools/delivery/src/deploy-gate.mts --project @ecoma-io/web-push-notification-job --lane production"
          }
        }
      },
      "build": {
        "executor": "@nx/esbuild:esbuild",
        "outputs": [
          "{options.outputPath}"
        ],
        "defaultConfiguration": "production",
        "options": {
          "platform": "neutral",
          "outputPath": "apps/web-push-notification-job/dist",
          "format": [
            "esm"
          ],
          "bundle": true,
          "main": "apps/web-push-notification-job/src/main.ts",
          "tsConfig": "apps/web-push-notification-job/tsconfig.app.json",
          "assets": [
            "apps/web-push-notification-job/src/assets"
          ],
          "esbuildOptions": {
            "sourcemap": true,
            "outExtension": {
              ".js": ".js"
            },
            "conditions": [
              "workerd",
              "worker",
              "browser"
            ]
          },
          "skipTypeCheck": true,
          "declaration": false
        },
        "configurations": {
          "development": {},
          "production": {
            "esbuildOptions": {
              "sourcemap": false,
              "outExtension": {
                ".js": ".js"
              },
              "conditions": [
                "workerd",
                "worker",
                "browser"
              ]
            }
          }
        }
      },
      "prune-lockfile": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "executor": "@nx/js:prune-lockfile",
        "inputs": [
          "default",
          "^default",
          "{workspaceRoot}/pnpm-workspace.yaml",
          "{workspaceRoot}/package.json",
          {
            "runtime": "node -e \"try{console.log('pnpm major '+require('child_process').execSync('pnpm --version',{stdio:['ignore','pipe','ignore']}).toString().trim().split('.')[0])}catch{console.log('pnpm major unavailable')}\""
          }
        ],
        "outputs": [
          "{workspaceRoot}/apps/web-push-notification-job/dist/package.json",
          "{workspaceRoot}/apps/web-push-notification-job/dist/pnpm-lock.yaml",
          "{workspaceRoot}/apps/web-push-notification-job/dist/pnpm-workspace.yaml",
          "{workspaceRoot}/apps/web-push-notification-job/dist/patches",
          "{workspaceRoot}/apps/web-push-notification-job/dist/local_path_modules"
        ],
        "options": {
          "buildTarget": "build"
        }
      },
      "copy-workspace-modules": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "outputs": [
          "{workspaceRoot}/apps/web-push-notification-job/dist/workspace_modules"
        ],
        "executor": "@nx/js:copy-workspace-modules",
        "options": {
          "buildTarget": "build"
        }
      },
      "prune": {
        "dependsOn": [
          "prune-lockfile",
          "copy-workspace-modules"
        ],
        "executor": "nx:noop"
      },
      "serve": {
        "continuous": true,
        "executor": "nx:run-commands",
        "defaultConfiguration": "development",
        "dependsOn": [
          "build"
        ],
        "options": {
          "cwd": "apps/web-push-notification-job",
          "command": "npx wrangler dev --config wrangler.jsonc"
        },
        "configurations": {}
      }
    }
  }
}
