{
  "name": "@ecoma-io/staff-access-relay",
  "version": "0.0.1",
  "private": true,
  "dependencies": {
    "@ecoma-io/staff-access-relay-application": "workspace:*",
    "@ecoma-io/staff-access-relay-infrastructure": "workspace:*",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "12.2.1",
    "@types/pg": "^8.23.1",
    "testcontainers": "12.2.1"
  },
  "//": "Relay outbox entitlement (P2.2, issue #449): claim staff_access.entitlement_outbox_events FOR UPDATE SKIP LOCKED, publish vào Cloudflare Queues với idempotency key = event_id. Hai lib tách bạch theo DDD: application giữ thuật toán relay (claim/publish/retry/DLQ) qua port, infrastructure cài port bằng driver pg. Composition root chỉ dựng pool từ Hyperdrive binding + adapter Queue từ binding Cloudflare Queues.",
  "nx": {
    "tags": [
      "type:composition",
      "scope:staff-access",
      "runtime:edge"
    ],
    "targets": {
      "test-integration": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "apps/staff-access-relay",
          "command": "npx vitest run -c vitest.integration.config.mts tests/integrations"
        }
      },
      "build": {
        "executor": "@nx/esbuild:esbuild",
        "outputs": [
          "{options.outputPath}"
        ],
        "defaultConfiguration": "production",
        "options": {
          "platform": "neutral",
          "outputPath": "apps/staff-access-relay/dist",
          "format": [
            "esm"
          ],
          "bundle": true,
          "main": "apps/staff-access-relay/src/main.ts",
          "tsConfig": "apps/staff-access-relay/tsconfig.app.json",
          "assets": [
            "apps/staff-access-relay/src/assets"
          ],
          "esbuildOptions": {
            "sourcemap": true,
            "outExtension": {
              ".js": ".js"
            },
            "conditions": [
              "workerd",
              "worker",
              "browser"
            ]
          },
          "skipTypeCheck": true,
          "declaration": false
        },
        "configurations": {
          "development": {},
          "production": {
            "esbuildOptions": {
              "sourcemap": false,
              "outExtension": {
                ".js": ".js"
              },
              "conditions": [
                "workerd",
                "worker",
                "browser"
              ]
            }
          }
        }
      },
      "prune-lockfile": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "executor": "@nx/js:prune-lockfile",
        "inputs": [
          "default",
          "^default",
          "{workspaceRoot}/pnpm-workspace.yaml",
          "{workspaceRoot}/package.json",
          {
            "runtime": "node -e \"try{console.log('pnpm major '+require('child_process').execSync('pnpm --version',{stdio:['ignore','pipe','ignore']}).toString().trim().split('.')[0])}catch{console.log('pnpm major unavailable')}\""
          }
        ],
        "outputs": [
          "{workspaceRoot}/apps/staff-access-relay/dist/package.json",
          "{workspaceRoot}/apps/staff-access-relay/dist/pnpm-lock.yaml",
          "{workspaceRoot}/apps/staff-access-relay/dist/pnpm-workspace.yaml",
          "{workspaceRoot}/apps/staff-access-relay/dist/patches",
          "{workspaceRoot}/apps/staff-access-relay/dist/local_path_modules"
        ],
        "options": {
          "buildTarget": "build"
        }
      },
      "copy-workspace-modules": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "outputs": [
          "{workspaceRoot}/apps/staff-access-relay/dist/workspace_modules"
        ],
        "executor": "@nx/js:copy-workspace-modules",
        "options": {
          "buildTarget": "build"
        }
      },
      "prune": {
        "dependsOn": [
          "prune-lockfile",
          "copy-workspace-modules"
        ],
        "executor": "nx:noop"
      },
      "serve": {
        "continuous": true,
        "executor": "nx:run-commands",
        "defaultConfiguration": "development",
        "dependsOn": [
          "build"
        ],
        "options": {
          "cwd": "apps/staff-access-relay",
          "command": "npx wrangler dev --config wrangler.jsonc"
        },
        "configurations": {}
      }
    }
  }
}
