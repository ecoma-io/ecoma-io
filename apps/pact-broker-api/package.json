{
  "name": "@ecoma-io/pact-broker-api",
  "private": true,
  "type": "module",
  "dependencies": {
    "@ecoma-io/pact-broker-api-domain": "workspace:*",
    "hono": "^4.13.13",
    "pg": "^8.23.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "12.2.1",
    "@types/pg": "^8.15.6",
    "testcontainers": "^12.2.1"
  },
  "nx": {
    "tags": [
      "type:composition",
      "scope:pact",
      "runtime:edge"
    ],
    "targets": {
      "build": {
        "executor": "@nx/esbuild:esbuild",
        "outputs": [
          "{options.outputPath}"
        ],
        "defaultConfiguration": "production",
        "options": {
          "platform": "neutral",
          "outputPath": "apps/pact-broker-api/dist",
          "format": [
            "esm"
          ],
          "bundle": true,
          "main": "apps/pact-broker-api/src/main.ts",
          "tsConfig": "apps/pact-broker-api/tsconfig.app.json",
          "esbuildOptions": {
            "sourcemap": true,
            "outExtension": {
              ".js": ".js"
            },
            "conditions": [
              "workerd",
              "worker",
              "browser"
            ],
            "external": [
              "node:buffer",
              "node:events",
              "node:stream"
            ]
          },
          "skipTypeCheck": true,
          "declaration": false
        },
        "configurations": {
          "development": {},
          "production": {
            "esbuildOptions": {
              "sourcemap": false,
              "outExtension": {
                ".js": ".js"
              },
              "conditions": [
                "workerd",
                "worker",
                "browser"
              ],
              "external": [
                "node:buffer",
                "node:events",
                "node:stream"
              ]
            }
          }
        }
      },
      "db:migrate": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "cwd": "apps/pact-broker-api",
          "command": "npx tsx --tsconfig tsconfig.db.json db/apply.mts"
        }
      },
      "typecheck-db": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "apps/pact-broker-api",
          "command": "npx tsc --noEmit -p tsconfig.db.json"
        }
      },
      "test-integration": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "build"
        ],
        "options": {
          "cwd": "apps/pact-broker-api",
          "command": "npx vitest run -c vitest.integration.config.mts tests/integrations tests/databases"
        }
      }
    }
  }
}
