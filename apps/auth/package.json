{
  "name": "@ecoma-io/auth",
  "version": "0.0.1",
  "private": true,
  "dependencies": {
    "@ecoma-io/account-contracts": "workspace:*",
    "@ecoma-io/auth-application": "workspace:*",
    "@ecoma-io/auth-contracts": "workspace:*",
    "@ecoma-io/auth-domain": "workspace:*",
    "@ecoma-io/auth-infrastructure": "workspace:*",
    "jose": "^6.2.12",
    "oidc-provider": "9.13.2",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "12.2.1",
    "@types/pg": "^8.23.1",
    "testcontainers": "12.2.1"
  },
  "nx": {
    "tags": [
      "type:composition",
      "scope:auth",
      "runtime:edge"
    ],
    "targets": {
      "build": {
        "executor": "@nx/esbuild:esbuild",
        "outputs": [
          "{options.outputPath}"
        ],
        "defaultConfiguration": "production",
        "options": {
          "platform": "neutral",
          "outputPath": "apps/auth/dist",
          "format": [
            "esm"
          ],
          "bundle": true,
          "main": "apps/auth/src/main.ts",
          "tsConfig": "apps/auth/tsconfig.app.json",
          "assets": [
            "apps/auth/src/assets"
          ],
          "esbuildOptions": {
            "sourcemap": true,
            "outExtension": {
              ".js": ".js"
            },
            "conditions": [
              "workerd",
              "worker",
              "browser"
            ],
            "external": [
              "node:buffer",
              "node:events",
              "node:stream",
              "node:http",
              "cloudflare:node"
            ]
          },
          "skipTypeCheck": true,
          "declaration": false
        },
        "configurations": {
          "development": {},
          "production": {
            "esbuildOptions": {
              "sourcemap": false,
              "outExtension": {
                ".js": ".js"
              },
              "conditions": [
                "workerd",
                "worker",
                "browser"
              ],
              "external": [
                "node:buffer",
                "node:events",
                "node:stream",
                "node:http",
                "cloudflare:node"
              ]
            }
          }
        }
      },
      "prune-lockfile": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "executor": "@nx/js:prune-lockfile",
        "inputs": [
          "default",
          "^default",
          "{workspaceRoot}/pnpm-workspace.yaml",
          "{workspaceRoot}/package.json",
          {
            "runtime": "node -e \"try{console.log('pnpm major '+require('child_process').execSync('pnpm --version',{stdio:['ignore','pipe','ignore']}).toString().trim().split('.')[0])}catch{console.log('pnpm major unavailable')}\""
          }
        ],
        "outputs": [
          "{workspaceRoot}/apps/auth/dist/package.json",
          "{workspaceRoot}/apps/auth/dist/pnpm-lock.yaml",
          "{workspaceRoot}/apps/auth/dist/pnpm-workspace.yaml",
          "{workspaceRoot}/apps/auth/dist/patches",
          "{workspaceRoot}/apps/auth/dist/local_path_modules"
        ],
        "options": {
          "buildTarget": "build"
        }
      },
      "copy-workspace-modules": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "outputs": [
          "{workspaceRoot}/apps/auth/dist/workspace_modules"
        ],
        "executor": "@nx/js:copy-workspace-modules",
        "options": {
          "buildTarget": "build"
        }
      },
      "prune": {
        "dependsOn": [
          "prune-lockfile",
          "copy-workspace-modules"
        ],
        "executor": "nx:noop"
      },
      "db:migrate": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "cwd": "apps/auth",
          "command": "npx tsx --tsconfig tsconfig.db.json db/apply.mts"
        }
      },
      "typecheck-db": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "apps/auth",
          "command": "npx tsc --noEmit -p tsconfig.db.json"
        }
      },
      "test-integration": {
        "executor": "nx:run-commands",
        "dependsOn": [],
        "options": {
          "cwd": "apps/auth",
          "command": "npx vitest run -c vitest.integration.config.mts tests/integrations tests/databases"
        },
        "//": [
          "KHÔNG `build`: suite integration import thẳng TS nguồn — `../../src/main`,",
          "`../../src/oidc/*`, các lib qua export `./src/index.ts` của workspace. Không",
          "spec nào đọc `dist/` hay type do wrangler sinh ra; esbuild bundle chỉ tiêu",
          "thụ ở làn deploy. Gỡ `build` khỏi dependsOn bỏ chi phí bundle mà không",
          "đổi cái suite chạy."
        ]
      },
      "serve": {
        "continuous": true,
        "executor": "nx:run-commands",
        "defaultConfiguration": "development",
        "dependsOn": [
          "build"
        ],
        "options": {
          "cwd": "apps/auth",
          "command": "npx wrangler dev --config wrangler.jsonc"
        },
        "configurations": {}
      }
    }
  }
}
