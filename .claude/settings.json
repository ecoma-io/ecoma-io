{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|patch|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "npx tsx tools/agent-hooks format-lint --root \"${OPENCODE_PROJECT_DIR:-${CLAUDE_PROJECT_DIR:-.}}\"",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
